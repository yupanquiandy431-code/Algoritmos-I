Algoritmo areaperimetroterreno
	//definir variables
	definir perimetro, area Como Real;
	definir ancho, largo como real;
	//entrada de datos
	Escribir "largo";
	Leer largo;
	Escribir "ancho";
	Leer ancho;
	perimetro<- ancho+ancho + largo+largo;
	area<- ancho*largo;
	Escribir "el area es:" area;
	escribir "el perimetro es:" perimetro;
FinAlgoritmo
