Algoritmo costoestacionamiento
    // Definir variables
    Definir montohora, horas, costototal Como Real;
    
    // Entrada de datos
    montohora <- 2.50;
    Escribir "Ingresa horas:";
    Leer horas;
    
    // 1. PRIMERO: Realiza el cálculo y guárdalo en la variable
    costototal <- horas * montohora;
    
    // 2. SEGUNDO: Muestra el mensaje con el resultado
    Escribir "El costo total es: ", costototal;
    
FinAlgoritmo